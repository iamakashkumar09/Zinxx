OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Used only for Module 1's optional voice-input transcription (Groq-hosted Whisper, free tier)
GROQ_API_KEY=gsk_your-key-here

# Stable Audio 3 Small — AI music and SFX generation (Module 9)
# Requires: pip install stable-audio-tools torchaudio
# Accept model terms at: https://huggingface.co/stabilityai/stable-audio-3-small-music
# and: https://huggingface.co/stabilityai/stable-audio-3-small-sfx
STABLE_AUDIO_MUSIC_MODEL=stabilityai/stable-audio-3-small-music
STABLE_AUDIO_SFX_MODEL=stabilityai/stable-audio-3-small-sfx
